# O D1 continua como backend ativo ate a validacao do Supabase.
DATA_BACKEND=d1

# Preencher somente em ambiente seguro. Nunca versionar valores reais.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Endereço público da autenticação Microsoft Entra ID.
ENTRA_REDIRECT_URI=https://raizeseriquezas-projetos-production.up.railway.app/Projetos/auth/callback

# Bootstrap do painel master (SaaS). Usar uma única vez para criar o primeiro super admin.
MASTER_BOOTSTRAP_TOKEN=
MASTER_BOOTSTRAP_EMAIL=

# Segredo para assinatura de tokens JWT (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=
